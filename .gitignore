# ─────────────────────────────────────────────────────────────
# Root .gitignore — applies in addition to per-app .gitignore files
# in backend/, customer-app/, staff-app/
# ─────────────────────────────────────────────────────────────

# Claude Code / IDE state (machine-local, never share)
.claude/

# Logs and tunnel state
*.log
.cloudflared.log

# Vendored binaries — install via the project's own composer/npm instead
composer.phar

# Backend public deployment targets — these are the build outputs of
# customer-app/staff-app deployed by the dev workflow (robocopy/cp from out/).
# They get overwritten on every deploy, so don't track them.
backend/public/admin/
backend/public/customer/
backend/public/district/
backend/public/state/
backend/public/taluk/
backend/public/vendor/

# Capacitor-generated native projects — regenerated by `npx cap add android`.
# Build-apk.sh creates these fresh in Codespaces; tracking them creates merge
# pain with no benefit while we don't customize the native code.
customer-app/android/
customer-app/ios/
staff-app/android/
staff-app/ios/

# Next.js statically exported assets (also in per-app .gitignores, repeated
# here for safety so nothing sneaks in if those files are edited)
customer-app/out/
customer-app/.next/
staff-app/out/
staff-app/.next/

# Per-role staff-app build outputs (deployed via robocopy to backend/public/{role}/)
staff-app/out-admin/
staff-app/out-district/
staff-app/out-state/
staff-app/out-taluk/
staff-app/out-vendor/

# Build archives — never commit these to git
*.tar.gz
*.zip

# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editor settings
.idea/
.vscode/
*.swp
*.swo
*~

# Gradle (in case it leaks above the android/ folder)
.gradle/
