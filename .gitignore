# ─────────────────────────────────────────────────────────────
# Root .gitignore — applies in addition to per-app .gitignore files
# in backend/, customer-app/, staff-app/
# ─────────────────────────────────────────────────────────────

# Claude Code / IDE state (machine-local, never share)
.claude/

# Logs and tunnel state
*.log
.cloudflared.log

# Vendored binaries — install via the project's own composer/npm instead
composer.phar

# Backend public deployment targets (build outputs of customer-app/staff-app).
# Temporarily tracked at user request — they overwrite on every deploy, so
# expect noisy diffs. Re-add to .gitignore later if this gets painful.
# backend/public/admin/
# backend/public/customer/
# backend/public/district/
# backend/public/driver/
# backend/public/state/
# backend/public/taluk/
# backend/public/vendor/

# Capacitor-generated native projects — regenerated by `npx cap add android`.
# Build-apk.sh creates these fresh in Codespaces; tracking them creates merge
# pain with no benefit while we don't customize the native code.
customer-app/android/
customer-app/ios/
staff-app/android/
staff-app/ios/

# Next.js statically exported assets (.next dev cache stays ignored; out/
# temporarily tracked at user request)
# customer-app/out/
customer-app/.next/
# staff-app/out/
staff-app/.next/

# Per-role staff-app build outputs (temporarily tracked at user request)
# staff-app/out-admin/
# staff-app/out-district/
# staff-app/out-driver/
# staff-app/out-staff-roll/
# staff-app/out-state/
# staff-app/out-taluk/
# staff-app/out-vendor/

# Build archives — never commit these to git
*.tar.gz
*.zip

# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editor settings
.idea/
.vscode/
*.swp
*.swo
*~

# Gradle (in case it leaks above the android/ folder)
.gradle/

# User-uploaded media (kept on server, not in git)
backend/public/uploads/ad-requests/
backend/public/uploads/customer-videos/
# Product images are generated per-environment (php spark images:optimize) and are
# huge — keeping them in git makes prod `git pull` abort on "untracked files would
# be overwritten". Server keeps its own copy.
backend/public/uploads/products/
backend/public/uploads/categories/
backend/public/uploads/banners/
